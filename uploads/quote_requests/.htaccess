# Prevent direct access to uploaded files
<Files *>
    Order Deny,Allow
    Deny from all
</Files>

# Allow specific file types to be downloaded (not executed)
<FilesMatch "\.(pdf|doc|docx|dwg|dxf|step|stp|iges|igs|stl|zip|rar|jpg|jpeg|png)$">
    Order Allow,Deny
    Allow from all
    # Force download instead of display
    Header set Content-Disposition "attachment"
</FilesMatch>
